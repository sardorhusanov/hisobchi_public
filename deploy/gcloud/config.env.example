# Copy to config.env. This file contains deployment settings, never credentials.
PROJECT_ID=
REGION=asia-south2
ZONE=asia-south2-a
DB_INSTANCE=hisobchi-db
DB_NAME=hisobchi
DB_USER=hisobchi_app
VM_NAME=hisobchi-bot
RUN_SERVICE=hisobchi-api
AR_REPO=hisobchi
SERVICE_ACCOUNT_NAME=hisobchi-runtime
# Optional: defaults to https://PROJECT_ID.web.app
FRONTEND_URL=
# Existing VPC/subnet to use for the VM (default network for a new project).
NETWORK=default
SUBNET=default
PROXY_VERSION=2.25.4
